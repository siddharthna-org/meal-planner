{
  "name": "vue-boilerplate",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:functions": "deno test --allow-env --config supabase/functions/hello-world/deno.json supabase/functions/hello-world/index_test.ts",
    "check:functions": "deno check --config supabase/functions/hello-world/deno.json supabase/functions/hello-world/index.ts supabase/functions/hello-world/index_test.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:functions:serve": "supabase functions serve hello-world",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@lucide/vue": "^1.57.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "deno": "2.9.6",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "shadcn-vue": "2.8.2",
    "supabase": "2.121.0",
    "vite": "^7.0.6",
    "vite-plugin-pwa": "^1.0.3",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
